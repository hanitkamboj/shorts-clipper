# AI Shorts Factory - Environment Configuration
# Copy this file to .env and fill in your values

# ---------------------------------------------------------
# AI Providers
# ---------------------------------------------------------

# Gemini (Primary Provider for Clip Selection & SEO)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# OpenRouter (Alternative AI Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3-opus
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider Selection (gemini | openrouter)
SHORTS_AI_PROVIDER=gemini

# ---------------------------------------------------------
# Transcription Configuration
# ---------------------------------------------------------

# Whisper Model Size (tiny | base | small | medium | large-v3)
SHORTS_WHISPER_MODEL=medium

# ---------------------------------------------------------
# YouTube API (For Uploads & Analytics)
# ---------------------------------------------------------

YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# ---------------------------------------------------------
# Instagram API (For Reels Uploads)
# ---------------------------------------------------------

IG_ACCESS_TOKEN=your_ig_access_token_here
IG_ACCOUNT_ID=your_ig_account_id_here

# ---------------------------------------------------------
# System Configuration
# ---------------------------------------------------------

# Output Workspace Directory (defaults to workspace/)
SHORTS_OUTPUT_DIR=workspace

# Max age (in days) for scouting trending videos
SHORTS_SCOUT_MAX_AGE_DAYS=7

# ---------------------------------------------------------
# Testing & Mocking (Development Only)
# ---------------------------------------------------------
# Set to 'true' to mock these services without making real API calls

MOCK_AI=false
MOCK_YOUTUBE=false
MOCK_RESEARCH=false
